// Firestore security rules for the portfolio.
// Full replacement: public reads for portfolio content, admin-only edits,
// and visitor-scoped live chat. Paste into the Firebase console
// (Firestore > Rules) and Publish.
//
// Required (one-time): Firebase console > Authentication >
// Sign-in method > Anonymous > Enable (visitors chat without an account).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'elvisbitolo11@gmail.com';
    }

    function isOwner(visitorId) {
      return isSignedIn() && request.auth.uid == visitorId;
    }

    // Public portfolio content - anyone reads, only the admin edits.
    match /site/profile {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lead enquiries from the pricing / M-Pesa landing forms.
    // Anyone can create a lead; only the admin can read or manage them.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'interest', 'message', 'createdAt', 'status']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Live chat - visitors only touch their own thread, admin touches all.
    match /chats/{visitorId} {
      allow read: if isOwner(visitorId) || isAdmin();
      allow create, update: if (isOwner(visitorId) || isAdmin())
        && request.resource.data.keys().hasOnly(
          ['visitorId', 'lastMessage', 'lastSender', 'updatedAt', 'createdAt', 'unread', 'visitorUnread']
        );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(visitorId) || isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['text', 'sender', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && ((isOwner(visitorId) && request.resource.data.sender == 'visitor')
            || (isAdmin() && request.resource.data.sender == 'admin'));
        allow update, delete: if isAdmin();
      }
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
